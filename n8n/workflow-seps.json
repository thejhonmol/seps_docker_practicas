      "position": [
        710,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json; return [{json: {mensaje:'Carga de boletines financieros terminada',importacion_id:r.importacion_id,celdas_leidas:r.read,celdas_validas:r.valid,celdas_observadas:r.observed,sha256:r.sha256}}];"
      },
      "id": "summary-seps",
      "name": "Resumen ETL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "throw new Error('La importación SEPS devolvió un estado inesperado: '+ JSON.stringify($input.first().json));"
      },
      "id": "error-seps",
      "name": "Error de calidad",
